# Development Configuration
# Copy this to .env.development

NODE_ENV=development
GATEWAY_PORT=3000

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Database (same as services use)
MONGO_URI=mongodb://admin:password@localhost:27017/gateway?authSource=admin

# JWT
JWT_SECRET=gateway_secret_key_dev
JWT_EXPIRY=7d

# Logging
LOG_LEVEL=debug
