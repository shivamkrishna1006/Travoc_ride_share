# Production Configuration
# Copy this to .env.production
# Update the values with your production endpoints

NODE_ENV=production
GATEWAY_PORT=3000

# Frontend URLs (production only - no localhost)
FRONTEND_URL=https://app.yourdomain.com

# Allowed origins (only production domains)
ALLOWED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com

# Database (production connection string)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/gateway?retryWrites=true&w=majority

# JWT (MUST change from development)
JWT_SECRET=your_very_secure_secret_key_change_this
JWT_EXPIRY=7d

# Logging (minimal in production)
LOG_LEVEL=info

# SSL/TLS (if running behind nginx/load balancer)
TRUST_PROXY=true
